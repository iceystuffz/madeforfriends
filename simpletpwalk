-- ============================================
--  MOBILE & PC DRAGGING LOGIC
-- ============================================
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ============================================
--  UI LOGIC
-- ============================================
local function updateSpeed(val)
    tpSpeed = math.clamp(val, 1, 500) -- Keep it between 1 and 500
    SpeedBox.Text = tostring(tpSpeed)
end

MinusBtn.MouseButton1Click:Connect(function()
    updateSpeed(tpSpeed - 10)
end)

PlusBtn.MouseButton1Click:Connect(function()
    updateSpeed(tpSpeed + 10)
end)

SpeedBox.FocusLost:Connect(function()
    local typed = tonumber(SpeedBox.Text)
    if typed then
        updateSpeed(typed)
    else
        SpeedBox.Text = tostring(tpSpeed) -- Revert if they typed letters
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    if isEnabled then
        ToggleBtn.Text = "ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 75)
    else
        ToggleBtn.Text = "OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        
        -- Restore normal walking speed when turned off
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = originalWalkSpeed end
        end
    end
end)

-- ============================================
--  TPWALK CORE LOGIC
-- ============================================
RunService.Heartbeat:Connect(function(dt)
    if not isEnabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp and hum.Health > 0 then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            -- Set walkspeed to 0 so the game's physics don't fight the teleport
            hum.WalkSpeed = 0
            
            -- Move the character forward based on speed and frame time
            hrp.CFrame = hrp.CFrame + (moveDir * (tpSpeed * dt))
        else
            -- Restore normal speed when standing still
            hum.WalkSpeed = originalWalkSpeed
        end
    end
end)

-- Reset walkspeed on respawn to prevent permanent 0 speed
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        originalWalkSpeed = hum.WalkSpeed
        hum.WalkSpeed = originalWalkSpeed
    end
end)
